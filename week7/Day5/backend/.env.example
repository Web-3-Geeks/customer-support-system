# Copy this file to .env and fill in the values. Never commit the real .env.

# --- Server ---
PORT=5000
# development or production. In production the server refuses to start if a setting below is missing or unsafe.
NODE_ENV=development

# --- Database (MongoDB Atlas) ---
# The connection string of your cluster. In Atlas, add the server's IP (or 0.0.0.0/0 on a host with changing IPs)
# under Network Access.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/customer-support

# --- Authentication ---
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
# How long a login lasts, for example 7d or 12h.
JWT_EXPIRES_IN=7d

# --- CORS and sockets ---
# The exact origin of the web app, with no trailing slash. Everything else is refused.
CLIENT_URL=http://localhost:5173

# --- Optional ---
# error, warn, info (default) or debug. Logs are JSON lines in production and readable lines in development.
LOG_LEVEL=info
# How often the SLA worker looks for tickets that are at risk or breached, in milliseconds (default 60000).
SLA_CHECK_INTERVAL_MS=60000

# --- Only used by `npm run seed:admin` ---
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password
