# Copy this file to .env. Vite only exposes variables that start with VITE_ to the browser, so never put a secret here.

# Base URL of the backend API, including /api.
#   local:       http://localhost:5000/api
#   production:  https://<your-backend-host>/api   (for example the Render URL)
VITE_API_URL=http://localhost:5000/api

# Optional. The socket connects to the API host (without /api). Only set this when the socket server lives elsewhere.
# VITE_SOCKET_URL=
